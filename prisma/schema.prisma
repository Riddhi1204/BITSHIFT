  inventory_id      String?            @db.Uuid
  blood_bank_id     String?            @db.Uuid
  hospital_id       String?            @db.Uuid
  blood_group       String             @db.VarChar(5)
  component         String             @default("whole_blood") @db.VarChar(50)
  units             Int
  reason            String             @db.VarChar(100)
  notes             String?
  wasted_at         DateTime?          @default(now()) @db.Timestamptz(6)
  recorded_by_id    String?            @db.Uuid
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
