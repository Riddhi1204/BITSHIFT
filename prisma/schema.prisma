/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model donor_matches {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id         String          @db.Uuid
  donor_id           String          @db.Uuid
  match_score        Decimal?        @db.Decimal(5, 2)
  distance_km        Decimal?        @db.Decimal(10, 2)
  blood_group_match  Boolean?        @default(false)
  availability_match Boolean?        @default(false)
  location_match     Boolean?        @default(false)
  eligibility_match  Boolean?        @default(false)
  ai_reason          String?
  status             String?         @default("suggested") @db.VarChar(30)
  created_at         DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?       @default(now()) @db.Timestamptz(6)
  users              users           @relation(fields: [donor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blood_requests     blood_requests  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notifications      notifications[]

  @@unique([request_id, donor_id])
  @@index([donor_id], map: "idx_matches_donor")
  @@index([request_id], map: "idx_matches_request")
  @@index([match_score(sort: Desc)], map: "idx_matches_score")
}

