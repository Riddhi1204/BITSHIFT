generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(100)
  entity_id   String?   @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.Inet
  user_agent  String?
  metadata    Json?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_audit_action")
  @@index([created_at(sort: Desc)], map: "idx_audit_created")
  @@index([user_id], map: "idx_audit_user")
}

model badges {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String           @unique @db.VarChar(100)
  description       String?
  icon_url          String?
  requirement_type  String?          @db.VarChar(50)
  requirement_value Int?
  points            Int?             @default(0)
  is_active         Boolean?         @default(true)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  citizen_badges    citizen_badges[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model blood_banks {
  id                                                                             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                                           String                 @db.VarChar(200)
  registration_number                                                            String?                @unique @db.VarChar(100)
  address                                                                        String
  city                                                                           String?                @db.VarChar(100)
  state                                                                          String?                @db.VarChar(100)
  region_id                                                                      String?                @db.Uuid
  phone                                                                          String?                @db.VarChar(20)
  email                                                                          String?                @db.VarChar(255)
  latitude                                                                       Decimal?               @db.Decimal(10, 7)
  longitude                                                                      Decimal?               @db.Decimal(10, 7)
  operating_hours                                                                String?
  verification_status                                                            String?                @default("pending") @db.VarChar(30)
  verified_by                                                                    String?                @db.Uuid
  verified_at                                                                    DateTime?              @db.Timestamptz(6)
  website_url                                                                    String?
  is_active                                                                      Boolean?               @default(true)
  created_at                                                                     DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                                                                     DateTime?              @default(now()) @db.Timestamptz(6)
  regions                                                                        regions?               @relation(fields: [region_id], references: [id], onUpdate: NoAction)
  users                                                                          users?                 @relation(fields: [verified_by], references: [id], onUpdate: NoAction)
  blood_inventory                                                                blood_inventory[]
  donation_campaigns                                                             donation_campaigns[]
  donations                                                                      donations[]
  inventory_transfers_inventory_transfers_destination_blood_bank_idToblood_banks inventory_transfers[]  @relation("inventory_transfers_destination_blood_bank_idToblood_banks")
  inventory_transfers_inventory_transfers_source_blood_bank_idToblood_banks      inventory_transfers[]  @relation("inventory_transfers_source_blood_bank_idToblood_banks")
  shortage_predictions                                                           shortage_predictions[]
  waste_records                                                                  waste_records[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model blood_inventory {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospital_id            String?             @db.Uuid
  blood_bank_id          String?             @db.Uuid
  blood_group            String              @db.VarChar(5)
  component              String?             @default("whole_blood") @db.VarChar(50)
  units_available        Int?                @default(0)
  reserved_units         Int?                @default(0)
  minimum_required_units Int?                @default(0)
  last_updated           DateTime?           @default(now()) @db.Timestamptz(6)
  created_at             DateTime?           @default(now()) @db.Timestamptz(6)
  blood_banks            blood_banks?        @relation(fields: [blood_bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hospitals              hospitals?          @relation(fields: [hospital_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_batches      inventory_batches[]
  waste_records          waste_records[]

  @@index([blood_bank_id], map: "idx_inventory_bank")
  @@index([blood_group], map: "idx_inventory_group")
  @@index([hospital_id], map: "idx_inventory_hospital")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model blood_requests {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_code     String          @unique @default(dbgenerated("('BG-'::text || upper(SUBSTRING(replace((gen_random_uuid())::text, '-'::text, ''::text) FROM 1 FOR 8)))")) @db.VarChar(30)
  requester_id     String          @db.Uuid
  hospital_id      String?         @db.Uuid
  patient_name     String?         @db.VarChar(150)
  patient_age      Int?
  patient_gender   String?         @db.VarChar(30)
  blood_group      String          @db.VarChar(5)
  component        String?         @default("whole_blood") @db.VarChar(50)
  units_required   Int
  units_fulfilled  Int?            @default(0)
  hospital_name    String?         @db.VarChar(200)
  hospital_address String?
  city             String?         @db.VarChar(100)
  state            String?         @db.VarChar(100)
  region_id        String?         @db.Uuid
  latitude         Decimal?        @db.Decimal(10, 7)
  longitude        Decimal?        @db.Decimal(10, 7)
  urgency          String?         @default("normal") @db.VarChar(20)
  status           String?         @default("active") @db.VarChar(30)
  required_by      DateTime?       @db.Timestamptz(6)
  contact_phone    String?         @db.VarChar(20)
  notes            String?
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  hospitals        hospitals?      @relation(fields: [hospital_id], references: [id], onUpdate: NoAction)
  regions          regions?        @relation(fields: [region_id], references: [id], onUpdate: NoAction)
  users            users           @relation(fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  donor_matches    donor_matches[]
  notifications    notifications[]

  @@index([blood_group], map: "idx_requests_blood_group")
  @@index([region_id], map: "idx_requests_region")
  @@index([status], map: "idx_requests_status")
  @@index([urgency], map: "idx_requests_urgency")
}

model citizen_badges {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citizen_id String    @db.Uuid
  badge_id   String    @db.Uuid
  earned_at  DateTime? @default(now()) @db.Timestamptz(6)
  badges     badges    @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [citizen_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([citizen_id, badge_id])
}

model citizen_profiles {
